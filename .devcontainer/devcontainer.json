{
  "name": "Commerce Business OS",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "remoteEnv": { "BIND_HOST": "0.0.0.0", "PORT": "8765" },
  "postCreateCommand": "pip install -r app/requirements-team.txt",
  "postAttachCommand": "nohup sh START_APP.sh > /tmp/crm.log 2>&1 &",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "CRM", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
